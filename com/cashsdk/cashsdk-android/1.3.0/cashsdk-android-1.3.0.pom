  <version>1.3.0</version>
  <packaging>aar</packaging>
  <name>CashSDK Android</name>
  <description>In-app purchase and paywall SDK for Android — Google Play Billing, server-verified entitlements, and remotely configured paywalls.</description>
  <url>https://cashsdk.com</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://github.com/cashsdk/cashsdk-android/blob/main/LICENSE</url>
    </license>
