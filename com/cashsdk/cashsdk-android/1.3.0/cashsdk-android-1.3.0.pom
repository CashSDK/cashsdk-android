      <name>CashSDK</name>
      <url>https://cashsdk.com</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/cashsdk/cashsdk-android.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/cashsdk/cashsdk-android.git</developerConnection>
    <url>https://github.com/cashsdk/cashsdk-android</url>
  </scm>
  <dependencies>
